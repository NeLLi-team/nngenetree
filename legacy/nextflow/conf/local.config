/*
 * Local Configuration for JGI SLURM Cluster
 */

params {
    // Database Configuration - NR database path (without .dmnd extension)
    blast_db = '/clusterfs/jgi/scratch/science/mgs/nelli/databases/nr/nr'

    // NCBI Entrez API Configuration
    entrez_email = 'fschulz@lbl.gov'

    // Query prefixes to track (genome IDs from archaeal genomes)
    query_prefixes = 'GCMeta_,GTDB_,spire_mag_'

    // Resource configuration with 24-hour runtime
    resources {
        run_diamond_blastp {
            threads = 8
            mem_mb = 64000
            time = '24h'
        }
        align_sequences {
            threads = 8
            mem_mb = 32000
            time = '24h'
            disk_mb = 50000
        }
        build_tree {
            threads = 8
            mem_mb = 32000
            time = '24h'
        }
        extract_hits {
            threads = 1
            mem_mb = 16000
            time = '4h'
        }
    }
}

// SLURM Configuration for JGI cluster
process {
    queue = 'jgi_normal'
    clusterOptions = '--qos=jgi_normal --account=grp-org-sc-mgs'
}
